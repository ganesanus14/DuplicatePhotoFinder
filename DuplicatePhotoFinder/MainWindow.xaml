<Window x:Class="DuplicatePhotoFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:DuplicatePhotoFinder.ViewModels"
        xmlns:conv="clr-namespace:DuplicatePhotoFinder.Converters"
        xmlns:views="clr-namespace:DuplicatePhotoFinder.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Duplicate Photo Finder"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Loaded="Window_Loaded">

    <!-- Global DataContext -->
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Converters -->
    <Window.Resources>
        <conv:FileSizeConverter          x:Key="FileSizeConverter" />
        <conv:BoolToVisibilityConverter  x:Key="BoolToVisConverter" />
        <conv:InverseBooleanConverter    x:Key="InverseBoolConverter" />
        <conv:PathToThumbnailConverter   x:Key="PathToThumbnailConverter" />
        <conv:DetectionModeConverter     x:Key="DetectionModeConverter" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" />

    </Window.Resources>

    <!-- MAIN LAYOUT WITH NAVIGATION -->
    <Grid>
        <ui:NavigationView x:Name="NavView"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsSettingsVisible="False"
                           SelectionChanged="NavView_SelectionChanged">

            <!-- Navigation Items -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Duplicates"
                                       Tag="Duplicates"
                                       Icon="Copy" />

                <ui:NavigationViewItem Content="People"
                                       Tag="People"
                                       Icon="Contact" />
            </ui:NavigationView.MenuItems>

            <!-- Content Host -->
            <ContentPresenter x:Name="MainContent" />
        </ui:NavigationView>
    </Grid>
</Window>
